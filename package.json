{
  "name": "sagitari",
  "productName": "SAGITARI",
  "version": "5.3.0",
  "description": "SAGITARI — agente de IA con control total del PC: chat, navegador y automatización del sistema",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "node scripts/lanzar.js --smoke",
    "lint": "eslint main agent renderer scripts test eslint.config.js",
    "lint:fix": "eslint main agent renderer scripts test eslint.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "uicheck": "node scripts/ui-check.js",
    "shots": "node scripts/shot-cdp.js shots all --demo",
    "contraste": "node scripts/contraste.js",
    "navcheck": "node scripts/navegador-check.js",
    "verificar:actualizador": "node scripts/verificar-actualizador.js 3",
    "banco": "node scripts/banco.js",
    "test": "node test/run.js",
    "test:renderer": "node test/renderer/run.js",
    "dist": "node scripts/dist.js",
    "dist:installer": "node scripts/dist.js --installer",
    "dist:portable": "node scripts/dist.js --portable",
    "release": "node scripts/release.js",
    "limpia": "node scripts/limpia.js",
    "cobertura": "c8 --reporter=text-summary --reporter=json-summary node test/run.js && c8 --reporter=text-summary --reporter=json-summary --clean=false node test/renderer/run.js"
  },
  "author": "Dario",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "undici": "7.29.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "c8": "^10.1.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9"
  },
  "build": {
    "appId": "com.sagitari.app",
    "productName": "SAGITARI",
    "copyright": "Copyright © 2026 Dario",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "agent/**/*",
      "renderer/**/*",
      "skills-starter/**/*",
      "package.json"
    ],
    "win": {
      "icon": "renderer/assets/sagitari.ico",
      "artifactName": "SAGITARI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SAGITARI",
      "artifactName": "SAGITARI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SAGITARI-Portable-${version}.${ext}"
    }
  }
}
