# Node / Electron
node_modules/
dist/
release/
build/

# Cuerpo de la release (lo crea .github/workflows/release.yml)
release-body.md

# Temporales de scripts/prepare-logo.ps1
scripts/tmp_ico/

# Espacio de trabajo temporal del arnés de interfaz (ui-check lo crea y lo borra)
sagi-ui-ws-*/

# Anuncio: video/audio (~9 MB) sin rastrear, no debe entrar en el historial
anuncio/

# Logs
*.log
npm-debug.log*

# OS
Thumbs.db
.DS_Store

# Editor
.vscode/
.idea/

# Git worktrees aislados del harness
.worktrees/

# Árboles de trabajo aislados que crean las pruebas (agent/arboles.js)
.tmp-arboles/

# Local test debris
_*.js
_*.png
_*.html
test-out.txt
# Sondas temporales de PowerShell: mismo criterio que las de arriba (una sonda de un
# rato no entra en el historial; si sirve de verdad, se sube sin el guion bajo).
_*.ps1

# Compañero visual de brainstorming (maquetas locales, no se versionan)
.superpowers/

# Mesa de diseño (briefs y capturas locales, no se publican)
.impeccable/

# Mesa de exploración de dirección (muestras y capturas locales, no se publican)
.oil/

# Capturas de npm run shots (se generan, no se versionan)
shots/

# Copia del PNG de diseño que deja scripts/make-assets.js dentro de assets (la fuente
# no se versiona: es un activo de diseño)
renderer/assets/logo-full.png

# Directorios de trabajo de asistentes locales (no se versionan)
.agent/

# Perfiles de datos que crean las pruebas (scripts/lanzar.js, scripts/shot-cdp.js)
.perfil-*/
# Cobertura (npm run cobertura)
coverage/
